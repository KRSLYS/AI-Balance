{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Balance",
  "mainBinaryName": "aibalance",
  "version": "0.1.0",
  "identifier": "com.krslys.aibalance",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Balance",
        "width": 420,
        "height": 680,
        "minWidth": 340,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "KRSLYS BV",
    "homepage": "https://aibalance.krslys.be/",
    "copyright": "Copyright © 2026 KRSLYS BV",
    "category": "DeveloperTool",
    "shortDescription": "Track your AI subscriptions and usage limits",
    "longDescription": "AI Balance shows how much of each AI plan you have used: session and weekly limits, credits and balances, all in one place.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3RkQ1MEUwMjM4QTc1OEUKUldTT2RZb2o0RkQ5bHh0OU8wcHRBaXIvaExXVFErZ09QSTJwRHdJV2NvRTVLNWh6cnpYQUVWVEoK",
      "endpoints": []
    }
  }
}
